views:
  - type: cards
    name: View
    filters:
      and:
        - spell.contains("Paladin Spell List")
    order:
      - file.basename
      - Casting Time
      - Range
      - Components
      - Duration
      - status
    cardSize: 170
    imageFit: ""
    imageAspectRatio: 1.2
    image: note.cover
  - type: table
    name: View 2
    order:
      - file.name
      - status
